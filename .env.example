VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key from Supabase dashboard → Settings → API>

# Server-only: never prefix with VITE_ (it would ship to the browser)
AI_STUDIO_API=<Google AI Studio API key>
# Optional; defaults to gemini-3.8-flash (STT + analyze)
AI_STUDIO_MODEL=
# Optional; defaults to gemini-3.5-flash-lite (grounded search is ~30x faster on it)
LOOKUP_MODEL=

# /api/send — one-click email via Resend. Without a key the UI falls back to mailto drafts.
RESEND_API_KEY=
# DEMO_MODE=true sends ALL emails to DEMO_INBOX instead of real institutions (never email banks on stage)
DEMO_MODE=true
DEMO_INBOX=<team inbox>
SEND_FROM=ScamSOS <onboarding@resend.dev>
